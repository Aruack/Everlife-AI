# =================================================================
# TEAM ORYVAN — Everlife AI | Evermind Engine
# Amazon Developer Hackathon 2026 — Bee Wearable AI Track
# =================================================================

# Server & Project Settings
PROJECT_NAME="Everlife AI"
ENGINE_NAME="Evermind"
TEAM_NAME="TEAM ORYVAN"
PORT=8000
ENVIRONMENT="development"

# Bee Wearable AI Integration
# Official CLI: @beeai/cli (npm install -g @beeai/cli)
# API Endpoint: https://app-api-developer.ce.bee.amazon.dev
BEE_CLI_CMD="bee"
BEE_API_URL="https://app-api-developer.ce.bee.amazon.dev"

# AWS Persistent Storage (Optional Cloud Mirroring)
# SQLite is the primary active local store. Configure keys to enable DynamoDB & S3 mirroring.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
DYNAMODB_TABLE_MEMORIES="everlife_memories"
S3_BUCKET_NAME="everlife-recordings-archive"

# Ring DoorstepOps Integration (developer.ring.com)
# Requires an Amazon Ring Partner account OAuth 2.0 token
RING_AUTH_TOKEN=""

# Fire TV FormShift Configuration
# Leanback web application container compliant
FIRETV_DEVICE_ID=""

# Alexa+ Custom Skill Integration
# Configure after creating Custom Skill in developer.amazon.com/alexa
ALEXA_SKILL_ID=""
